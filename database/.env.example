# Copy to .env (docker compose reads it automatically) and adjust if needed.
# These are the network credentials the db container is reachable with —
# nothing here is a real secret, this is a local ephemeral dev database.

POSTGRES_USER=ridgeline
POSTGRES_PASSWORD=ridgeline
POSTGRES_DB=ridgeline

# Host port the container's 5432 is published on. Change this if something
# else on your machine already listens on 5432.
POSTGRES_PORT=5432

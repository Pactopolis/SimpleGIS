# Copy to .env (docker compose reads it automatically) and adjust if needed.
# Used by docker-compose.yml, the full-stack dev stack (db + backend +
# frontend with hot reloading).

# Host filesystem path this repo checkout lives at, used for the bind mounts
# that give backend/frontend hot reloading. Only needs setting when the
# Docker daemon runs outside the environment you're typing commands in (e.g.
# this project's devcontainer, via docker-outside-of-docker) — in that case
# .devcontainer/post-create.sh detects and writes it here automatically.
# Leave unset if you're running `docker compose` directly against your local
# Docker daemon; it defaults to this directory.
#HOST_REPO_ROOT=.

# Same database credentials as database/.env.example — nothing here is a
# real secret, this is a local ephemeral dev database.
POSTGRES_USER=ridgeline
POSTGRES_PASSWORD=ridgeline
POSTGRES_DB=ridgeline
POSTGRES_PORT=5432
